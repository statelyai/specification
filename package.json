{
  "name": "@statelyai/spec",
  "version": "0.1.0",
  "description": "The Stately JSON specification for statecharts and workflows",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "test": "tsx --test",
    "build": "tsdown && npm run generate-schema",
    "generate-schema": "tsx src/generate-schema.ts",
    "prepublish": "npm run build"
  },
  "keywords": [
    "stately",
    "statecharts",
    "xstate",
    "json",
    "specification",
    "statechart",
    "state-machine",
    "workflow"
  ],
  "author": "david@stately.ai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.2",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "zod": ">=4.0.0"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./machine.json": "./schemas/machine.json",
    "./graph.json": "./schemas/graph.json"
  }
}
